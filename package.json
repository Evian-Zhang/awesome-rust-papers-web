{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=23.6"
	},
	"scripts": {
		"predev": "npm run proto:generate",
		"dev": "vite dev",
		"prebuild": "npm run proto:generate",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run proto:generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"precheck:watch": "npm run proto:generate",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest:logic": "npm run proto:generate",
		"test:logic": "node tests/logic-test.ts",
		"proto:generate": "buf generate"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.75.0",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@eslint/js": "^10.0.1",
		"@rgrove/parse-xml": "^5.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@lucide/svelte": "^1.60.0",
		"echarts": "^6.1.0",
		"feed": "^6.0.0",
		"simple-icons": "^16.35.0"
	}
}
